      "undefined_when": []
    },
    {
      "feature_id": "baseline_sell_quote_mad_120m",
      "category": "BASELINE",
      "formula": "MEDIAN(ABS(taker_sell_quote_volume - baseline_sell_quote_median_120m))",
      "source_fields": [
        "taker_sell_quote_volume"
      ],
      "temporal_phases": [
        "BASELINE"
      ],
      "units": "QUOTE_ASSET",
      "undefined_when": []
    },
    {
      "feature_id": "baseline_sell_share_median_120m",
      "category": "BASELINE",
      "formula": "MEDIAN(taker_sell_quote_volume / quote_volume per BASELINE minute)",
