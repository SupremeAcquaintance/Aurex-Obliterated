//@version=6
// Aurex strategy version: 1.1.0
strategy(
     "Aurex volatility_breakout_v1",
     overlay = true,
     pyramiding = 0,
     initial_capital = 1000,
     currency = currency.USD,
     commission_type = strategy.commission.percent,
     commission_value = 0.05,
     slippage = 2,
     calc_on_every_tick = false,
     process_orders_on_close = true
)

backtestStart = input.time(timestamp("1 Feb 2023 00:00 +0000"), "Backtest start")
backtestEnd = input.time(timestamp("1 Jul 2026 00:00 +0000"), "Backtest end")
higherTimeframe = input.timeframe("60", "Higher timeframe")
emaFastLength = input.int(50, "Higher timeframe EMA fast", minval = 1)
emaSlowLength = input.int(200, "Higher timeframe EMA slow", minval = 1)
breakoutLookback = input.int(20, "Breakout lookback", minval = 5)
compressionLookback = input.int(40, "Compression lookback", minval = 10)
atrLength = input.int(14, "ATR length", minval = 1)
atrStopMultiplier = input.float(1.8, "ATR stop multiplier", minval = 0.1, step = 0.1)
rewardRiskRatio = input.float(2.0, "Reward:risk ratio", minval = 1.0, step = 0.1)
volumeLength = input.int(20, "Volume average length", minval = 1)
volumeExpansion = input.float(1.15, "Volume expansion", minval = 1.0, step = 0.05)
riskPerTradePercent = input.float(0.3, "Risk per trade (%)", minval = 0.1, maxval = 2.0, step = 0.1)
maxPositionValuePercent = input.float(95.0, "Max position value (%)", minval = 1.0, maxval = 100.0, step = 1.0)
enableLong = input.bool(true, "Enable long")
enableShort = input.bool(true, "Enable short")
showDiagnostics = input.bool(true, "Show diagnostic table", group = "Diagnostics")
strategyVersion = "1.1.0"

if barstate.isfirst and timeframe.in_seconds(higherTimeframe) <= timeframe.in_seconds()
    runtime.error("Higher timeframe must be greater than the chart timeframe.")

atrValue = ta.atr(atrLength)
atrAverage = ta.sma(atrValue, compressionLookback)
volumeAverage = ta.sma(volume, volumeLength)
rangeHigh = ta.highest(high, breakoutLookback)
rangeLow = ta.lowest(low, breakoutLookback)
previousRangeHigh = rangeHigh[1]
previousRangeLow = rangeLow[1]

htfEmaFast = request.security(
     syminfo.tickerid,
     higherTimeframe,
     ta.ema(close, emaFastLength)[1],
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_on
)
htfEmaSlow = request.security(
     syminfo.tickerid,
     higherTimeframe,
     ta.ema(close, emaSlowLength)[1],
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_on
)

compression = atrValue < atrAverage
volumeConfirmed = volumeAverage > 0 and volume >= volumeAverage * volumeExpansion
flatPosition = strategy.position_size == 0
longBias = htfEmaFast > htfEmaSlow
shortBias = htfEmaFast < htfEmaSlow
longBreakout = close > previousRangeHigh and close > open
shortBreakout = close < previousRangeLow and close < open
inBacktestWindow = time >= backtestStart and time < backtestEnd
entryWindow = inBacktestWindow and time_close < backtestEnd
backtestExitBar = time < backtestEnd and time_close >= backtestEnd

configuredSlippagePrice = 2 * syminfo.mintick
expectedLongEntry = close + configuredSlippagePrice
expectedShortEntry = close - configuredSlippagePrice
longStop = close - (atrValue * atrStopMultiplier)
shortStop = close + (atrValue * atrStopMultiplier)
longRisk = expectedLongEntry - longStop
shortRisk = shortStop - expectedShortEntry
longTakeProfit = expectedLongEntry + (longRisk * rewardRiskRatio)
shortTakeProfit = expectedShortEntry - (shortRisk * rewardRiskRatio)

riskCapital = math.max(strategy.equity, 0) * (riskPerTradePercent / 100)
contractPointValue = math.max(syminfo.pointvalue, syminfo.mintick)
minimumContract = math.max(syminfo.mincontract, 0.00000001)
longMaxPositionQuantity = expectedLongEntry > 0 ? (strategy.equity * (maxPositionValuePercent / 100)) / (expectedLongEntry * contractPointValue) : 0
shortMaxPositionQuantity = expectedShortEntry > 0 ? (strategy.equity * (maxPositionValuePercent / 100)) / (expectedShortEntry * contractPointValue) : 0
longRiskQuantity = longRisk > syminfo.mintick ? riskCapital / (longRisk * contractPointValue) : 0
shortRiskQuantity = shortRisk > syminfo.mintick ? riskCapital / (shortRisk * contractPointValue) : 0
longQuantityRaw = math.min(longRiskQuantity, longMaxPositionQuantity)
shortQuantityRaw = math.min(shortRiskQuantity, shortMaxPositionQuantity)
longQuantity = math.floor(longQuantityRaw / minimumContract) * minimumContract
shortQuantity = math.floor(shortQuantityRaw / minimumContract) * minimumContract
longRiskOk = longRisk > syminfo.mintick and longQuantity > 0
shortRiskOk = shortRisk > syminfo.mintick and shortQuantity > 0

longSetup = enableLong and flatPosition and entryWindow and barstate.isconfirmed and compression and volumeConfirmed and longBias and longBreakout and longRiskOk
shortSetup = enableShort and flatPosition and entryWindow and barstate.isconfirmed and compression and volumeConfirmed and shortBias and shortBreakout and shortRiskOk

formatPrice(price) =>
    str.tostring(price, format.mintick)

formatSetting(value) =>
    str.tostring(value)

formatBoolSetting(value) =>
    value ? "true" : "false"

formatTimestampSetting(value) =>
    str.format_time(value, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC")

timestampIso() =>
    str.format_time(time, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC")

settingsFingerprint() =>
    "volatility_breakout_v1" +
     "|initial_capital=1000" +
     "|backtest_start=" + formatTimestampSetting(backtestStart) +
     "|backtest_end=" + formatTimestampSetting(backtestEnd) +
     "|higher_timeframe=" + higherTimeframe +
     "|htf_ema_fast=" + str.tostring(emaFastLength) +
     "|htf_ema_slow=" + str.tostring(emaSlowLength) +
     "|breakout_lookback=" + str.tostring(breakoutLookback) +
     "|compression_lookback=" + str.tostring(compressionLookback) +
     "|atr_length=" + str.tostring(atrLength) +
     "|atr_stop_multiplier=" + formatSetting(atrStopMultiplier) +
     "|reward_risk=" + formatSetting(rewardRiskRatio) +
     "|volume_length=" + str.tostring(volumeLength) +
     "|volume_expansion=" + formatSetting(volumeExpansion) +
     "|risk_per_trade_percent=" + formatSetting(riskPerTradePercent) +
     "|max_position_value_percent=" + formatSetting(maxPositionValuePercent) +
     "|enable_long=" + formatBoolSetting(enableLong) +
     "|enable_short=" + formatBoolSetting(enableShort)

signalMessage(direction, entryPrice, stopLoss, takeProfit) =>
    "{" +
     "\"source\":\"tradingview\"," +
     "\"strategy\":\"volatility_breakout_v1\"," +
     "\"strategy_version\":\"" + strategyVersion + "\"," +
     "\"settings_fingerprint\":\"" + settingsFingerprint() + "\"," +
     "\"symbol\":\"" + syminfo.ticker + "\"," +
     "\"timeframe\":\"" + timeframe.period + "\"," +
     "\"direction\":\"" + direction + "\"," +
     "\"entry_price\":" + formatPrice(entryPrice) + "," +
     "\"stop_loss\":" + formatPrice(stopLoss) + "," +
     "\"take_profit\":" + formatPrice(takeProfit) + "," +
     "\"market_regime\":\"BREAKOUT_EXPANSION\"," +
     "\"timestamp\":\"" + timestampIso() + "\"" +
     "}"

longMessage = signalMessage("LONG", expectedLongEntry, longStop, longTakeProfit)
shortMessage = signalMessage("SHORT", expectedShortEntry, shortStop, shortTakeProfit)

if longSetup
    strategy.entry("AUREX-BREAKOUT-LONG", strategy.long, qty = longQuantity, alert_message = longMessage)
    strategy.exit("AUREX-BREAKOUT-LONG-EXIT", from_entry = "AUREX-BREAKOUT-LONG", stop = longStop, limit = longTakeProfit)
    alert(longMessage, alert.freq_once_per_bar_close)

if shortSetup
    strategy.entry("AUREX-BREAKOUT-SHORT", strategy.short, qty = shortQuantity, alert_message = shortMessage)
    strategy.exit("AUREX-BREAKOUT-SHORT-EXIT", from_entry = "AUREX-BREAKOUT-SHORT", stop = shortStop, limit = shortTakeProfit)
    alert(shortMessage, alert.freq_once_per_bar_close)

if backtestExitBar and strategy.position_size != 0
    strategy.close_all(comment = "Backtest window end")

var int diagnosticBars = 0
var int compressionPass = 0
var int volumePass = 0
var int longBiasPass = 0
var int shortBiasPass = 0
var int longBreakoutPass = 0
var int shortBreakoutPass = 0
var int longSetupCount = 0
var int shortSetupCount = 0

if barstate.isconfirmed and inBacktestWindow
    diagnosticBars += 1
    if compression
        compressionPass += 1
    if volumeConfirmed
        volumePass += 1
    if longBias
        longBiasPass += 1
    if shortBias
        shortBiasPass += 1
    if longBreakout
        longBreakoutPass += 1
    if shortBreakout
        shortBreakoutPass += 1
    if longSetup
        longSetupCount += 1
    if shortSetup
        shortSetupCount += 1

formatDiagnosticCount(count) =>
    str.tostring(count) + "/" + str.tostring(diagnosticBars)

var table diagnosticTable = table.new(position.top_right, 3, 7, border_width = 1)
headerColor = color.new(color.rgb(10, 20, 32), 0)
labelColor = color.new(color.rgb(17, 24, 39), 0)

if showDiagnostics and barstate.islast
    table.cell(diagnosticTable, 0, 0, "Aurex breakout", text_color = color.white, bgcolor = headerColor)
    table.cell(diagnosticTable, 1, 0, "Long", text_color = color.white, bgcolor = headerColor)
    table.cell(diagnosticTable, 2, 0, "Short", text_color = color.white, bgcolor = headerColor)
    table.cell(diagnosticTable, 0, 1, "Bars", text_color = color.white, bgcolor = labelColor)
    table.cell(diagnosticTable, 1, 1, str.tostring(diagnosticBars), text_color = color.white)
    table.cell(diagnosticTable, 2, 1, str.tostring(diagnosticBars), text_color = color.white)
    table.cell(diagnosticTable, 0, 2, "Compression", text_color = color.white, bgcolor = labelColor)
    table.cell(diagnosticTable, 1, 2, formatDiagnosticCount(compressionPass), text_color = color.white)
    table.cell(diagnosticTable, 2, 2, formatDiagnosticCount(compressionPass), text_color = color.white)
    table.cell(diagnosticTable, 0, 3, "Volume", text_color = color.white, bgcolor = labelColor)
    table.cell(diagnosticTable, 1, 3, formatDiagnosticCount(volumePass), text_color = color.white)
    table.cell(diagnosticTable, 2, 3, formatDiagnosticCount(volumePass), text_color = color.white)
    table.cell(diagnosticTable, 0, 4, "HTF bias", text_color = color.white, bgcolor = labelColor)
    table.cell(diagnosticTable, 1, 4, formatDiagnosticCount(longBiasPass), text_color = color.white)
    table.cell(diagnosticTable, 2, 4, formatDiagnosticCount(shortBiasPass), text_color = color.white)
    table.cell(diagnosticTable, 0, 5, "Breakout", text_color = color.white, bgcolor = labelColor)
    table.cell(diagnosticTable, 1, 5, formatDiagnosticCount(longBreakoutPass), text_color = color.white)
    table.cell(diagnosticTable, 2, 5, formatDiagnosticCount(shortBreakoutPass), text_color = color.white)
    table.cell(diagnosticTable, 0, 6, "Setups", text_color = color.white, bgcolor = labelColor)
    table.cell(diagnosticTable, 1, 6, str.tostring(longSetupCount), text_color = color.white)
    table.cell(diagnosticTable, 2, 6, str.tostring(shortSetupCount), text_color = color.white)

plot(previousRangeHigh, "Breakout range high", color = color.new(color.green, 20))
plot(previousRangeLow, "Breakout range low", color = color.new(color.red, 20))
plotshape(longSetup, title = "Aurex breakout long", style = shape.triangleup, color = color.lime, location = location.belowbar, size = size.tiny)
plotshape(shortSetup, title = "Aurex breakout short", style = shape.triangledown, color = color.red, location = location.abovebar, size = size.tiny)
