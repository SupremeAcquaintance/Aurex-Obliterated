AUREX_APP_NAME=Aurex
AUREX_ENVIRONMENT=local
AUREX_LOG_LEVEL=INFO
AUREX_DATABASE_URL=sqlite:///./data/aurex.db
AUREX_LIVE_TRADING_ENABLED=false
AUREX_WEBHOOK_SECRET=local-dev-secret
AUREX_PAPER_COMMISSION_BPS=10
AUREX_PAPER_HALF_SPREAD_BPS=2.5
AUREX_PAPER_MARKET_IMPACT_BPS=2.5
AUREX_PAPER_LATENCY_MS=500
